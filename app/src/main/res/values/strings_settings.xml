    <!-- Sign-in clients -->
    <string name="settings_sign_in_clients">Sign-in clients</string>
    <string name="settings_client_id">Google client ID</string>
    <string name="settings_client_id_label">Client ID</string>
    <string name="settings_client_id_none">Not set. Needed only to sign in to Google in the browser or with the Google account on this phone.</string>
    <string name="settings_client_id_invalid">This is not a Google OAuth client ID. A client ID ends with .apps.googleusercontent.com.</string>
    <string name="settings_client_id_in_use">Accounts that sign in with Google use this client. After a change, sign in to them again.</string>
    <string name="settings_client_id_guide">Sign-in with Google in the browser and with the Google account on this phone needs an OAuth client that you own.\n\n1. In the Google Cloud console, make a project.\n2. Set up the OAuth consent screen: \"External\", publishing status \"In production\", and a support email that is not personal.\n3. Make an OAuth client of the type Android for the package name %1$s and the SHA-1 of the key that signs this app.\n4. Copy the client ID into this field.\n\nGoogle can refuse browser sign-in for new clients. An app password always works.</string>
    <string name="settings_ms_client_id">Microsoft client ID</string>
    <string name="settings_ms_client_id_none">Not set. Needed to sign in to Outlook.com and Microsoft 365.</string>
    <string name="settings_ms_client_id_invalid">This is not a Microsoft client ID. A client ID has 32 hexadecimal digits in 5 groups.</string>
    <string name="settings_ms_client_id_in_use">Microsoft accounts use this client. After a change, sign in to them again.</string>
    <!-- 1: the redirect URI of Plico -->
    <string name="settings_ms_client_id_guide">Sign-in to Outlook.com and Microsoft 365 needs a client that you register at Microsoft.\n\n1. In the Microsoft Entra admin center, go to App registrations → New registration.\n2. Select \"Any Entra ID tenant and personal Microsoft accounts\".\n3. Under Authentication, add the platform Mobile and desktop applications with the redirect URI %1$s.\n4. Copy the Application (client) ID into this field.</string>

